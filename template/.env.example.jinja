{{ service_env_prefix }}_APPLICATION__ENVIRONMENT=development
{{ service_env_prefix }}_APPLICATION__VERSION=0.1.0
{{ service_env_prefix }}_HTTP__HOST=127.0.0.1
{{ service_env_prefix }}_HTTP__PORT=8000

{{ service_env_prefix }}_LOGFIRE__ENABLED=true
{{ service_env_prefix }}_LOGFIRE__SEND_TO_LOGFIRE=false
{{ service_env_prefix }}_LOGFIRE__CONSOLE=true
{{ service_env_prefix }}_LOGFIRE__MINIMUM_LEVEL=info
# {{ service_env_prefix }}_LOGFIRE__TOKEN=replace-with-a-Logfire-write-token

# Local development only. Replace the placeholder; never reuse it outside a local database.
{{ service_env_prefix }}_DATABASE__URL=postgresql+asyncpg://{{ service_slug }}:replace-with-local-password@127.0.0.1:5432/{{ database_name }}
{{ service_env_prefix }}_DATABASE__POOL_SIZE=5
{{ service_env_prefix }}_DATABASE__MAX_OVERFLOW=5
{{ service_env_prefix }}_DATABASE__POOL_TIMEOUT_SECONDS=10
{{ service_env_prefix }}_DATABASE__COMMAND_TIMEOUT_SECONDS=10
