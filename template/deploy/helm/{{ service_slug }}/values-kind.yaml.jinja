replicaCount: 1

image:
  pullPolicy: IfNotPresent

environment:
  {{ service_env_prefix }}_APPLICATION__ENVIRONMENT: development
  {{ service_env_prefix }}_APPLICATION__VERSION: "0.1.0"
  {{ service_env_prefix }}_LOGFIRE__ENABLED: "true"
  {{ service_env_prefix }}_LOGFIRE__SEND_TO_LOGFIRE: "false"
  {{ service_env_prefix }}_LOGFIRE__CONSOLE: "true"
  {{ service_env_prefix }}_LOGFIRE__MINIMUM_LEVEL: info
  {{ service_env_prefix }}_BUSINESS_OPERATION_FINGERPRINT__KEY_VERSION: "1"

secretEnvironment:
  {{ service_env_prefix }}_BUSINESS_OPERATION_FINGERPRINT__SECRET:
    enabled: false
  {{ service_env_prefix }}_LOGFIRE__TOKEN:
    enabled: false
  {{ service_env_prefix }}_DATABASE__URL:
    enabled: true
    name: {{ service_slug }}-local-runtime
    key: database-url

gunicorn:
  workers: 1

resources:
  requests:
    cpu: 50m
    memory: 96Mi
  limits:
    cpu: 250m
    memory: 256Mi
