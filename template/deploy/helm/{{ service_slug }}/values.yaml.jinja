replicaCount: 2

image:
  repository: pokerlost/{{ service_slug }}
  tag: "0.1.0"
  pullPolicy: IfNotPresent

http:
  port: 8000

environment:
  {{ service_env_prefix }}_APPLICATION__ENVIRONMENT: production
  {{ service_env_prefix }}_APPLICATION__VERSION: "0.1.0"
  {{ service_env_prefix }}_HTTP__HOST: 0.0.0.0
  {{ service_env_prefix }}_HTTP__PORT: "8000"
  {{ service_env_prefix }}_LOGFIRE__ENABLED: "true"
  {{ service_env_prefix }}_LOGFIRE__SEND_TO_LOGFIRE: "true"
  {{ service_env_prefix }}_LOGFIRE__CONSOLE: "true"
  {{ service_env_prefix }}_LOGFIRE__MINIMUM_LEVEL: info
  {{ service_env_prefix }}_DATABASE__POOL_SIZE: "10"
  {{ service_env_prefix }}_DATABASE__MAX_OVERFLOW: "10"
  {{ service_env_prefix }}_DATABASE__POOL_TIMEOUT_SECONDS: "10"
  {{ service_env_prefix }}_DATABASE__COMMAND_TIMEOUT_SECONDS: "30"

secretEnvironment:
  {{ service_env_prefix }}_LOGFIRE__TOKEN:
    enabled: true
    name: {{ service_slug }}-logfire
    key: token
  {{ service_env_prefix }}_DATABASE__URL:
    enabled: true
    name: {{ service_slug }}-runtime
    key: database-url

gunicorn:
  workers: 2
  timeout: 30
  gracefulTimeout: 30
  keepalive: 5
  forwardedAllowIps: "127.0.0.1"

service:
  # Keep this ClusterIP behind mandatory deployment HTTPS/TLS termination.
  type: ClusterIP
  port: 80

resources:
  requests:
    cpu: 100m
    memory: 128Mi
  limits:
    cpu: 500m
    memory: 512Mi

podSecurityContext:
  runAsNonRoot: true
  runAsUser: 10001
  runAsGroup: 10001
  fsGroup: 10001
  seccompProfile:
    type: RuntimeDefault

containerSecurityContext:
  allowPrivilegeEscalation: false
  readOnlyRootFilesystem: true
  capabilities:
    drop:
      - ALL

terminationGracePeriodSeconds: 40
