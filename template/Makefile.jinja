.DEFAULT_GOAL := help

UV ?= uv
PYTHONPATH := app
HTTP_HOST ?= 0.0.0.0
HTTP_PORT ?= 8000
GUNICORN_WORKERS ?= 2
GUNICORN_TIMEOUT ?= 30
GUNICORN_GRACEFUL_TIMEOUT ?= 30
GUNICORN_KEEPALIVE ?= 5
GUNICORN_FORWARDED_ALLOW_IPS ?= 127.0.0.1
HELM_CHART := deploy/helm/{{ service_slug }}

define require_tool
	@command -v "$(1)" >/dev/null 2>&1 || { echo "Required tool not found: $(1)" >&2; exit 127; }
endef

.PHONY: help install lock lock-check run serve format format-check lint typecheck compile docs-check pre-commit check check-full db-upgrade db-downgrade db-revision docker-build helm-lint helm-template

help: ## Show this help message
	$(call require_tool,awk)
	@awk 'BEGIN {FS = ":.*## "} /^[a-zA-Z0-9_-]+:.*## / {printf "  %-18s %s\n", $$1, $$2}' $(MAKEFILE_LIST)

install: ## Install dependencies from uv.lock
	$(call require_tool,$(UV))
	$(UV) sync --locked

lock: ## Resolve dependencies and write uv.lock
	$(call require_tool,$(UV))
	$(UV) lock

lock-check: ## Verify that uv.lock matches pyproject.toml
	$(call require_tool,$(UV))
	$(UV) lock --check

run: ## Run the local Uvicorn development server
	$(call require_tool,$(UV))
	env PYTHONPATH=$(PYTHONPATH) $(UV) run --locked {{ service_slug }} run

serve: ## Run the production Gunicorn server
	$(call require_tool,$(UV))
	env PYTHONPATH=$(PYTHONPATH) $(UV) run --locked gunicorn "api.application:create_app()" --worker-class uvicorn_worker.UvicornWorker --bind "$(HTTP_HOST):$(HTTP_PORT)" --workers "$(GUNICORN_WORKERS)" --timeout "$(GUNICORN_TIMEOUT)" --graceful-timeout "$(GUNICORN_GRACEFUL_TIMEOUT)" --keep-alive "$(GUNICORN_KEEPALIVE)" --forwarded-allow-ips "$(GUNICORN_FORWARDED_ALLOW_IPS)" --access-logfile - --error-logfile - --capture-output --worker-tmp-dir /tmp

format: ## Apply Ruff lint fixes and formatting
	$(call require_tool,$(UV))
	$(UV) run --locked ruff check --fix .
	$(UV) run --locked ruff format .

format-check: ## Check Ruff formatting without changing files
	$(call require_tool,$(UV))
	$(UV) run --locked ruff format --check .

lint: ## Run Ruff lint without changing files
	$(call require_tool,$(UV))
	$(UV) run --locked ruff check .

typecheck: ## Run strict mypy
	$(call require_tool,$(UV))
	env PYTHONPATH=$(PYTHONPATH) $(UV) run --locked mypy

compile: ## Compile Python sources, Alembic entry, and scripts
	$(call require_tool,$(UV))
	$(UV) run --locked python -m compileall -q app alembic/env.py scripts

docs-check: ## Validate the documentation contract
	$(call require_tool,$(UV))
	$(UV) run --locked python scripts/check_documentation.py

pre-commit: ## Run every pre-commit hook against all files
	$(call require_tool,$(UV))
	$(UV) run --locked pre-commit run --all-files --show-diff-on-failure

check: lock-check format-check lint typecheck compile docs-check ## Run regular non-mutating local checks

check-full: check pre-commit ## Run regular checks and all pre-commit hooks

db-upgrade: ## Upgrade PostgreSQL to the Alembic head
	$(call require_tool,$(UV))
	env PYTHONPATH=$(PYTHONPATH) $(UV) run --locked alembic upgrade head

db-downgrade: ## Downgrade PostgreSQL by one Alembic revision
	$(call require_tool,$(UV))
	env PYTHONPATH=$(PYTHONPATH) $(UV) run --locked alembic downgrade -1

db-revision: ## Create an autogenerated revision with message=<text>
	$(call require_tool,$(UV))
	@test -n "$(message)" || (echo "message is required" >&2; exit 2)
	env PYTHONPATH=$(PYTHONPATH) $(UV) run --locked alembic revision --autogenerate -m "$(message)"

docker-build: ## Build the local image with forwarded GitHub SSH access
	$(call require_tool,docker)
	docker build \
		--ssh default \
		--secret id=github_known_hosts,src="$$HOME/.ssh/known_hosts" \
		-t "pokerlost-{{ service_slug }}:local" \
		.

helm-lint: ## Lint the Helm chart
	$(call require_tool,helm)
	helm lint "$(HELM_CHART)"

helm-template: ## Render the Helm chart locally
	$(call require_tool,helm)
	helm template "{{ service_slug }}" "$(HELM_CHART)"
