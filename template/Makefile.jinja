UV ?= uv
PYTHONPATH := app
HTTP_HOST ?= 0.0.0.0
HTTP_PORT ?= 8000
GUNICORN_WORKERS ?= 2
GUNICORN_TIMEOUT ?= 30
GUNICORN_GRACEFUL_TIMEOUT ?= 30
GUNICORN_KEEPALIVE ?= 5
GUNICORN_FORWARDED_ALLOW_IPS ?= 127.0.0.1

.PHONY: help install lock run serve format lint typecheck pre-commit compile db-upgrade db-downgrade db-revision

help:
	@echo "install       Install locked dependencies"
	@echo "lock          Resolve and write uv.lock"
	@echo "run           Run the local Uvicorn development server"
	@echo "serve         Run the production Gunicorn server"
	@echo "format        Apply Ruff fixes and formatting"
	@echo "lint          Check Ruff lint and formatting"
	@echo "typecheck     Run strict mypy"
	@echo "pre-commit    Run all pre-commit hooks"
	@echo "compile       Compile Python sources"
	@echo "db-upgrade    Upgrade PostgreSQL to Alembic head"
	@echo "db-downgrade  Downgrade PostgreSQL by one revision"
	@echo "db-revision   Create an autogenerated revision with message=<text>"

install:
	$(UV) sync --locked

lock:
	$(UV) lock

run:
	PYTHONPATH=$(PYTHONPATH) $(UV) run --locked {{ service_slug }} run

serve:
	PYTHONPATH=$(PYTHONPATH) $(UV) run --locked gunicorn "api.application:create_app()" --worker-class uvicorn_worker.UvicornWorker --bind "$(HTTP_HOST):$(HTTP_PORT)" --workers "$(GUNICORN_WORKERS)" --timeout "$(GUNICORN_TIMEOUT)" --graceful-timeout "$(GUNICORN_GRACEFUL_TIMEOUT)" --keep-alive "$(GUNICORN_KEEPALIVE)" --forwarded-allow-ips "$(GUNICORN_FORWARDED_ALLOW_IPS)" --access-logfile - --error-logfile - --capture-output --worker-tmp-dir /tmp

format:
	$(UV) run --locked ruff check --fix .
	$(UV) run --locked ruff format .

lint:
	$(UV) run --locked ruff check .
	$(UV) run --locked ruff format --check .

typecheck:
	PYTHONPATH=$(PYTHONPATH) $(UV) run --locked mypy

pre-commit:
	$(UV) run --locked pre-commit run --all-files

compile:
	$(UV) run --locked python -m compileall -q app alembic/env.py

db-upgrade:
	PYTHONPATH=$(PYTHONPATH) $(UV) run --locked alembic upgrade head

db-downgrade:
	PYTHONPATH=$(PYTHONPATH) $(UV) run --locked alembic downgrade -1

db-revision:
	@test -n "$(message)" || (echo "message is required" >&2; exit 2)
	PYTHONPATH=$(PYTHONPATH) $(UV) run --locked alembic revision --autogenerate -m "$(message)"
