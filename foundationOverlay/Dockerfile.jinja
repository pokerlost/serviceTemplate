{% extends "composedTemplate/_base/fastApiDockerfile.jinja" %}
{% block extraBuildStages %}FROM scratch AS sdk-source
COPY docker/sdk-source.empty /sdk-source.empty

{% endblock %}
{% block dependencyAcquisition %}RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --chmod=0755 docker/sdk_askpass.sh /usr/local/bin/sdk_askpass
COPY --chmod=0755 docker/sdk_sync.sh /usr/local/bin/sdk_sync
COPY --from=sdk-source / /opt/sdk-source/
ARG SDK_SOURCE_MODE=remote
RUN --mount=type=cache,id={{ packageName }}-runtime-python314-linux-amd64,target=/root/.cache/uv,sharing=locked \
    --mount=type=secret,id=sdk_token \
    sdk_sync --no-dev
{% endblock %}
{% block testDependencies %}RUN --mount=type=cache,id={{ packageName }}-development-python314-linux-amd64,target=/root/.cache/uv,sharing=locked \
    --mount=type=secret,id=sdk_token \
    sdk_sync --all-groups
{% endblock %}
