_FIXTURE_KEY = b"synthetic-test-only-key-never-used-by-runtime"


class FixtureScopes(StrEnum):
    __new__ = scope_module.Scopes._new_member_
    READ = "accounts.self.getMe"
    ADMIN = "auth.client.manage"


def context(
    *, audience: str = "{{ service_name }}", granted: bool = True
) -> PokerlostAuthorizationContext:
    return PokerlostAuthorizationContext(
        principal_id=UUID(int=1),
        client_id=UUID(int=2),
        principal_type=PrincipalType.SERVICE,
        service_name="technicalFixture",
        audience=PokerlostAudience(audience),
        scopes=(
            PokerlostScopes.ACCOUNTS_SELF_GET_ME
            if granted
            else PokerlostScopes.AUTH_CLIENT_MANAGE,
        ),
    )


def signed_token(
    value: PokerlostAuthorizationContext, *, expires_at: int = 1001
) -> str:
    payload = json.dumps(
        {"context": value.model_dump(mode="json"), "expires_at": expires_at},
        sort_keys=True,
    ).encode()
    encoded = base64.urlsafe_b64encode(payload).decode().rstrip("=")
    signature = hmac.new(_FIXTURE_KEY, encoded.encode(), hashlib.sha256).hexdigest()
    return encoded + "." + signature


class SignedFixtureVerifier:
    """Verify synthetic signed inputs at a fixed test clock; no runtime policy."""

    def __init__(self) -> None:
        self.calls: list[PokerlostAudience] = []

    async def verify(
        self, token: SecretStr, *, audience: PokerlostAudience
    ) -> PokerlostAuthorizationContext:
        self.calls.append(audience)
        encoded, signature = token.get_secret_value().split(".", 1)
        expected = hmac.new(_FIXTURE_KEY, encoded.encode(), hashlib.sha256).hexdigest()
        if not hmac.compare_digest(expected, signature):
            raise authorization.AuthorizationError(
                "POKERLOST_ACCESS_TOKEN_INVALID", 401, "Access token is invalid."
            )
        payload = json.loads(
            base64.urlsafe_b64decode(encoded + "=" * (-len(encoded) % 4))
        )
        if payload["expires_at"] <= 1000:
            raise authorization.AuthorizationError(
                "POKERLOST_ACCESS_TOKEN_EXPIRED", 401, "Access token has expired."
            )
        return PokerlostAuthorizationContext.model_validate_json(
            json.dumps(payload["context"])
        )


