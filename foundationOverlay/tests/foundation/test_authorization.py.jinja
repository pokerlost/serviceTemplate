@pytest.mark.parametrize(
    "header", [None, "", "Basic synthetic", "Bearer", "Bearer a b", "Bearer a\tb"]
)
def test_missing_or_malformed_header_never_reaches_handler(
    protected_application: tuple[FastAPI, list[UUID]], header: str | None
) -> None:
    application, calls = protected_application
    verifier = SignedFixtureVerifier()
    application.state.token_verifier = verifier
    with TestClient(application) as client:
        response = client.post(
            "/technicalProtected",
            headers={} if header is None else {"Authorization": header},
        )
    assert response.status_code == 401
    assert response.json() == {
        "ok": False,
        "result": None,
        "error": "POKERLOST_AUTHENTICATION_REQUIRED",
        "error_message": "Authentication is required.",
        "retry_after": None,
    }
    assert calls == [] and verifier.calls == []


@pytest.mark.parametrize("failure", ["signature", "expired", "audience", "scope"])
def test_invalid_tokens_fail_before_handler(
    protected_application: tuple[FastAPI, list[UUID]], failure: str
) -> None:
    application, calls = protected_application
    verifier = SignedFixtureVerifier()
    application.state.token_verifier = verifier
    token = signed_token(
        context(
            audience="otherService" if failure == "audience" else "{{ service_name }}",
            granted=failure != "scope",
        ),
        expires_at=999 if failure == "expired" else 1001,
    )
    if failure == "signature":
        token = token[:-1] + ("0" if token[-1] != "0" else "1")
    with TestClient(application) as client:
        response = client.post(
            "/technicalProtected", headers={"Authorization": "Bearer " + token}
        )
    assert response.status_code == (403 if failure == "scope" else 401)
    expected = {
        "signature": "POKERLOST_ACCESS_TOKEN_INVALID",
        "expired": "POKERLOST_ACCESS_TOKEN_EXPIRED",
        "audience": "POKERLOST_ACCESS_TOKEN_INVALID",
        "scope": "POKERLOST_INSUFFICIENT_SCOPE",
    }
    assert response.json()["error"] == expected[failure]
    assert token not in response.text
    assert "detail" not in response.json()
    assert calls == []
    assert verifier.calls == [PokerlostAudience("{{ service_name }}")]


def test_valid_scope_and_audience_reach_handler_once(
    protected_application: tuple[FastAPI, list[UUID]],
) -> None:
    application, calls = protected_application
    application.state.token_verifier = SignedFixtureVerifier()
    with TestClient(application) as client:
        response = client.post(
            "/technicalProtected",
            headers={"Authorization": "bEaReR " + signed_token(context())},
        )
    assert response.status_code == 200
    assert response.json()["result"] == 17
    assert calls == [UUID(int=1)]
    operation = application.openapi()["paths"]["/technicalProtected"]["post"]
    assert operation["security"] == [{"PokerlostOAuth2": [FixtureScopes.READ.value]}]


