@pytest.mark.parametrize(
    ("required", "message"),
    [
        ([], "at least one"),
        (["unknown.scope"], "unknown"),
        ([FixtureScopes.READ.value] * 2, "duplicate"),
    ],
)
def test_invalid_route_scope_configuration_fails_closed(
    protected_application: tuple[FastAPI, list[UUID]],
    required: list[str],
    message: str,
) -> None:
    application, calls = protected_application
    request = Request({"type": "http", "app": application})
    with pytest.raises(RuntimeError, match=message):
        asyncio.run(
            authorization.authorize_pokerlost_request(
                SecurityScopes(required), None, request
            )
        )
    assert calls == []


def test_scope_catalog_requires_complete_nonempty_descriptions(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    assert scope_module.scope_descriptions() == {
        scope.value: description
        for scope, description in scope_module.SCOPE_DESCRIPTIONS.items()
    }
    monkeypatch.setattr(scope_module, "Scopes", FixtureScopes)
    monkeypatch.setattr(scope_module, "SCOPE_DESCRIPTIONS", {})
    with pytest.raises(RuntimeError, match="one description"):
        scope_module.scope_descriptions()
    descriptions = {FixtureScopes.READ: "Read", FixtureScopes.ADMIN: " "}
    monkeypatch.setattr(scope_module, "SCOPE_DESCRIPTIONS", descriptions)
    with pytest.raises(RuntimeError, match="not be empty"):
        scope_module.scope_descriptions()
    descriptions[FixtureScopes.ADMIN] = "Manage"
    assert scope_module.scope_descriptions() == {
        FixtureScopes.READ.value: "Read",
        FixtureScopes.ADMIN.value: "Manage",
    }


