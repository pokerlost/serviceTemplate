name: CI

on:
  push:
  pull_request:
  workflow_dispatch:
    inputs:
      reviewed_sha:
        description: Full reviewed commit SHA for the private SDK build
        required: true
        type: string

permissions:
  contents: read

concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: true

jobs:
  source:
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@5a7eac68fb9809dea845d802897dc5c723910fa3 # v7.1.3
        with:
          version: "0.12.15"
          enable-cache: false
      - run: uv python install 3.14
      - name: Parse project metadata and lock
        run: |
          python3 - <<'PY'
          import tomllib
          from pathlib import Path
          for name in ('pyproject.toml', 'uv.lock'):
              with Path(name).open('rb') as source:
                  tomllib.load(source)
          PY
      - run: uvx --from 'ruff==0.16.4' ruff check .
      - run: uvx --from 'ruff==0.16.4' ruff format --check .
      - run: '"$(uv python find 3.14)" -m compileall -q src'

  privateBuild:
    needs: source
    if: {% raw %}${{ github.event_name == 'workflow_dispatch' && inputs.reviewed_sha == github.sha && github.repository_owner == 'pokerlost' }}{% endraw %}
    runs-on: ubuntu-24.04
    timeout-minutes: 30
    environment: sdk-build
{% if withPersistence %}    services:
      postgres:
        image: postgres:17.11-trixie
        env:
          POSTGRES_USER: ci
          POSTGRES_PASSWORD: ci
          POSTGRES_DB: ci
        ports:
          - 5432:5432
        options: >-
          --health-cmd "pg_isready -U ci -d ci"
          --health-interval 5s
          --health-timeout 5s
          --health-retries 12
{% endif %}    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          persist-credentials: false
          ref: {% raw %}${{ inputs.reviewed_sha }}{% endraw %}
      - uses: astral-sh/setup-uv@5a7eac68fb9809dea845d802897dc5c723910fa3 # v7.1.3
        with:
          version: "0.12.15"
          enable-cache: false
      - run: uv python install 3.14
      - name: Require approved SDK App configuration
        env:
          SDK_APP_ID: {% raw %}${{ secrets.POKERLOST_SDK_APP_ID }}{% endraw %}
          SDK_APP_PRIVATE_KEY: {% raw %}${{ secrets.POKERLOST_SDK_APP_PRIVATE_KEY }}{% endraw %}
        run: |
          if [ -z "$SDK_APP_ID" ] || [ -z "$SDK_APP_PRIVATE_KEY" ]; then
            echo 'BLOCKED: repository-scoped SDK GitHub App secrets are not configured'
            exit 1
          fi
      - name: Mint SDK-only read token
        id: sdkToken
        uses: actions/create-github-app-token@bcd2ba49218906704ab6c1aa796996da409d3eb1 # v3.2.0
        with:
          app-id: {% raw %}${{ secrets.POKERLOST_SDK_APP_ID }}{% endraw %}
          private-key: {% raw %}${{ secrets.POKERLOST_SDK_APP_PRIVATE_KEY }}{% endraw %}
          owner: pokerlost
          repositories: pypokerlost
          permission-contents: read
      - name: Locked private SDK build and installed-wheel startup
        env:
          SDK_APP_TOKEN: {% raw %}${{ steps.sdkToken.outputs.token }}{% endraw %}
{% if withPersistence %}          DATABASE_URL: postgresql+asyncpg://ci:ci@127.0.0.1:5432/ci
          TEST_DATABASE_URL: postgresql+asyncpg://ci:ci@127.0.0.1:5432/ci
{% endif %}        run: |
          set -euo pipefail
          umask 077
          container=""
          gitConfig="$RUNNER_TEMP/sdkGitConfig"
          askpass="$RUNNER_TEMP/sdkAskpass"
          trap 'if [ -n "$container" ]; then docker rm -f "$container" >/dev/null; fi; rm -f "$gitConfig" "$askpass" "$RUNNER_TEMP/runtimeRequirements.txt"' EXIT
          git config --file "$gitConfig" \
            url."https://github.com/pokerlost/pypokerlost.git".insteadOf \
            'ssh://git@github.com/pokerlost/pypokerlost.git'
          cat > "$askpass" <<'SH'
          #!/bin/sh
          case "$1" in
            *Username*) printf '%s\n' x-access-token ;;
            *Password*) printf '%s\n' "$SDK_APP_TOKEN" ;;
            *) exit 1 ;;
          esac
          SH
          chmod 700 "$askpass"
          export GIT_CONFIG_GLOBAL="$gitConfig"
          export GIT_ASKPASS="$askpass"
          export GIT_TERMINAL_PROMPT=0
          export UV_NO_GITHUB_FAST_PATH=1
          uv lock --check
          uv sync --locked --python 3.14
          uv run --locked ruff check src
          uv run --locked ruff format --check src
          uv run --locked mypy
{% if withTesting %}          uv run --locked pytest -q
{% if withPersistence %}          uv run --locked alembic upgrade head
          uv run --locked pytest -q tests/database_integration.py
{% endif %}
{% endif %}
          uv build
          uv export --locked --no-dev --no-emit-project --output-file "$RUNNER_TEMP/runtimeRequirements.txt"
          uv venv "$RUNNER_TEMP/wheelCheck" --python 3.14
          uv pip install --python "$RUNNER_TEMP/wheelCheck/bin/python" --requirement "$RUNNER_TEMP/runtimeRequirements.txt"
          uv pip install --no-deps --python "$RUNNER_TEMP/wheelCheck/bin/python" dist/*.whl
{% if withDocker %}          DOCKER_BUILDKIT=1 docker build --secret id=sdk_token,env=SDK_APP_TOKEN --tag {{ packageName | lower }}:reviewed .
{% if withPersistence %}          container="$(docker run --detach --rm --network host --env DATABASE_URL="$DATABASE_URL" {{ packageName | lower }}:reviewed)"
          port=8000
{% else %}          container="$(docker run --detach --rm --publish 127.0.0.1::8000 {{ packageName | lower }}:reviewed)"
          port="$(docker port "$container" 8000/tcp | tail -n 1 | cut -d: -f2)"
{% endif %}          ready=false
          for attempt in $(seq 1 20); do
            if curl --fail --silent "http://127.0.0.1:$port/health/live"; then ready=true; break; fi
            sleep 1
          done
          if [ "$ready" != true ]; then docker logs --tail 20 "$container"; exit 1; fi
{% endif %}
          cd "$RUNNER_TEMP"
          "$RUNNER_TEMP/wheelCheck/bin/python" - <<'PY'
          import asyncio
          from importlib.metadata import version
          from httpx import ASGITransport, AsyncClient
          from {{ packageName }}.app import create_app

          async def main():
              app = create_app()
              async with app.router.lifespan_context(app):
                  async with AsyncClient(transport=ASGITransport(app=app), base_url='http://test') as client:
                      for path in ('/', '/getOpenApi', '/health/live', '/health/ready'):
                          response = await client.get(path)
                          assert response.status_code == 200, (path, response.status_code)
              assert not hasattr(app.state, 'resources')
              print('installed SDK', version('pypokerlost'))
              print('infrastructure startup passed; resources disposed')

          asyncio.run(main())
          PY
