"""Fail-closed local bearer verification for future protected operations."""

from __future__ import annotations

from typing import Annotated, Protocol

from fastapi import FastAPI, Request, Security
from fastapi.openapi.models import OAuthFlowClientCredentials, OAuthFlows
from fastapi.responses import JSONResponse
from fastapi.security import OAuth2, SecurityScopes
from fastapi.security.utils import get_authorization_scheme_param
from pydantic import SecretStr
from pypokerlost.types import (
    PokerlostAudience,
    PokerlostAuthorizationContext,
    PokerlostResponse,
)

from {{ packageName }}.scopes import Scopes, scope_descriptions

_AUDIENCE = PokerlostAudience("{{ service_name }}")


class PokerlostTokenVerifier(Protocol):
    """A service-owned local verifier, supplied only after real authorization design."""

    async def verify(
        self, token: SecretStr, *, audience: PokerlostAudience
    ) -> PokerlostAuthorizationContext: ...


class AuthorizationError(Exception):
    """A safe, canonical authentication or authorization failure."""

    def __init__(self, code: str, status_code: int, message: str) -> None:
        super().__init__(message)
        self.code = code
        self.status_code = status_code
        self.message = message


OAUTH2 = OAuth2(
    flows=OAuthFlows(
        clientCredentials=OAuthFlowClientCredentials(
            tokenUrl="/getToken", scopes=scope_descriptions()
        )
    ),
    scheme_name="PokerlostOAuth2",
    auto_error=False,
)
AuthorizationHeader = Annotated[str | None, Security(OAUTH2)]


async def authorize_pokerlost_request(
    security_scopes: SecurityScopes,
    authorization_header: AuthorizationHeader,
    request: Request,
) -> PokerlostAuthorizationContext:
    """Require exact route scopes, bearer token, audience, and local verification."""
    if not security_scopes.scopes:
        raise RuntimeError("Protected operations require at least one exact scope")
    try:
        required = tuple(Scopes(value) for value in security_scopes.scopes)
    except ValueError:
        raise RuntimeError("Protected operation declares an unknown scope") from None
    if len(set(required)) != len(required):
        raise RuntimeError("Protected operation declares duplicate scopes")
    if authorization_header is None:
        raise AuthorizationError(
            "POKERLOST_AUTHENTICATION_REQUIRED", 401, "Authentication is required."
        )
    scheme, token_value = get_authorization_scheme_param(authorization_header)
    if (
        scheme.casefold() != "bearer"
        or not token_value
        or any(character.isspace() for character in token_value)
    ):
        raise AuthorizationError(
            "POKERLOST_AUTHENTICATION_REQUIRED", 401, "Authentication is required."
        )
    verifier = getattr(request.app.state, "token_verifier", None)
    if verifier is None:
        raise RuntimeError("Pokerlost token verifier is not configured")
    context: PokerlostAuthorizationContext = await verifier.verify(
        SecretStr(token_value), audience=_AUDIENCE
    )
    if context.audience != _AUDIENCE:
        raise AuthorizationError(
            "POKERLOST_ACCESS_TOKEN_INVALID", 401, "Access token is invalid."
        )
    granted = frozenset(scope.value for scope in context.scopes)
    if any(scope.value not in granted for scope in required):
        raise AuthorizationError(
            "POKERLOST_INSUFFICIENT_SCOPE", 403, "Required scope is missing."
        )
    return context


def configure_authorization_errors(application: FastAPI) -> None:
    """Publish safe SDK envelopes for the authorization boundary."""

    @application.exception_handler(AuthorizationError)
    async def handle_authorization_error(
        request: Request, error: AuthorizationError
    ) -> JSONResponse:
        del request
        response = PokerlostResponse[None](
            ok=False, error=error.code, error_message=error.message
        )
        return JSONResponse(
            status_code=error.status_code,
            content=response.model_dump(mode="json"),
            headers=(
                {"WWW-Authenticate": "Bearer"} if error.status_code == 401 else None
            ),
        )
